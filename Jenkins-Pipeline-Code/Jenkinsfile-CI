pipeline {
    agent any

    environment {
        GIT_URL       = 'https://github.com/Har0709/EKS-End-to-End.git'
        GIT_BRANCH    = 'dev'

        DOCKER_IMAGE  = 'My-image'
        IMAGE_TAG     = "${BUILD_NUMBER}"

        SONAR_SERVER  = 'sonarqube-server'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: "${GIT_BRANCH}",
                    credentialsId: 'github-creds',
                    url: "${GIT_URL}"
            }
        }

        stage('Verify Tools') {
            steps {
                sh '''
                git --version
                docker --version
                node --version
                npm --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                sh '''
                npm install
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                npm run lint
                '''
            }
        }

        stage('Unit Test') {
            steps {
                sh '''
                npm test
                '''
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonarqube-server') {
                    sh '''
                    sonar-scanner \
                    -Dsonar.projectKey=deepmap \
                    -Dsonar.projectName=deepmap \
                    -Dsonar.sources=. \
                    -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                    '''
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} .
                '''
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                trivy image \
                --severity HIGH,CRITICAL \
                --exit-code 1 \
                ${DOCKER_IMAGE}:${IMAGE_TAG}
                '''
            }
        }

        stage('Archive Reports') {
            steps {
                archiveArtifacts artifacts: '**/*', fingerprint: true
            }
        }

    }

    post {

        success {
            echo '========================================'
            echo 'CI Pipeline Passed'
            echo 'Pull Request is ready for review.'
            echo '========================================'
        }

        failure {
            echo '========================================'
            echo 'CI Pipeline Failed'
            echo 'Fix the issues before merging the PR.'
            echo '========================================'
        }

        always {
            cleanWs()
        }
    }
}
