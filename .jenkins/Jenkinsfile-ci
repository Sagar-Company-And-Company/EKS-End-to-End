pipeline {
    agent any

    environment {
        GITHUB_REPO   = 'Sagar-Company-And-Company/EKS-End-to-End'
        SOURCE_BRANCH = 'PR-test'
        TARGET_BRANCH = 'dev'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('CI Test') {
            steps {
                sh '''
                    set -e

                    echo "======================================"
                    echo "Running CI"
                    echo "======================================"

                    echo "Running Unit Test..."
                    echo "Running Code Build..."
                    echo "Running Sonar Test..."

                    echo "======================================"
                    echo "CI PASSED"
                    echo "======================================"
                '''
            }
        }

        stage('Create PR') {
            when {
                branch 'PR-test'
            }

            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "Checking Existing PR"
                        echo "======================================"

                        RESPONSE=$(curl -s \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&head=Sagar-Company-And-Company:${SOURCE_BRANCH}&base=${TARGET_BRANCH}")

                        echo "$RESPONSE"

                        PR_NUMBER=$(echo "$RESPONSE" | python3 -c '
import sys
import json

data = json.load(sys.stdin)

if data:
    print(data[0]["number"])
else:
    print("")
')

                        if [ -n "$PR_NUMBER" ]; then
                            echo "Existing PR found: #${PR_NUMBER}"

                        else
                            echo "No existing PR found"
                            echo "Creating PR: ${SOURCE_BRANCH} -> ${TARGET_BRANCH}"

                            CREATE_RESPONSE=$(curl -s -X POST \
                                -u "${GH_USER}:${GH_TOKEN}" \
                                -H "Accept: application/vnd.github+json" \
                                -H "Content-Type: application/json" \
                                "https://api.github.com/repos/${GITHUB_REPO}/pulls" \
                                -d "{
                                    \"title\": \"Automatic PR: ${SOURCE_BRANCH} -> ${TARGET_BRANCH}\",
                                    \"head\": \"${SOURCE_BRANCH}\",
                                    \"base\": \"${TARGET_BRANCH}\",
                                    \"body\": \"Automatically created by Jenkins after successful CI.\"
                                }")

                            echo "$CREATE_RESPONSE"

                            PR_NUMBER=$(echo "$CREATE_RESPONSE" | python3 -c '
import sys
import json

data = json.load(sys.stdin)

if "number" not in data:
    print("")

else:
    print(data["number"])
')

                            if [ -z "$PR_NUMBER" ]; then
                                echo "ERROR: Failed to create PR"
                                exit 1
                            fi

                            echo "Created PR #${PR_NUMBER}"
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo "JENKINS CI SUCCESS"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "JENKINS CI FAILED"
            echo "======================================"
        }
    }
}
