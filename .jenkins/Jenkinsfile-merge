pipeline {
    agent any

    environment {
        GITHUB_REPO   = 'Sagar-Company-And-Company/EKS-End-to-End'
        SOURCE_BRANCH = 'PR-test'
        TARGET_BRANCH = 'dev'
    }

    stages {

        stage('Find PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "FINDING OPEN PR"
                        echo "PR-test -> dev"
                        echo "======================================"

                        curl -s \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&per_page=100" \
                          > prs.json

                        python3 <<'PY'
import json
import sys

with open("prs.json") as f:
    data = json.load(f)

if isinstance(data, dict) and "message" in data:
    print("GitHub API ERROR:", data["message"])
    sys.exit(1)

found = None

for pr in data:
    head = pr.get("head", {})
    base = pr.get("base", {})

    print(
        "Checking PR #{} : {} -> {}".format(
            pr.get("number"),
            head.get("ref"),
            base.get("ref")
        )
    )

    if (
        head.get("ref") == "PR-test"
        and base.get("ref") == "dev"
        and pr.get("state") == "open"
    ):
        found = pr["number"]
        break

if not found:
    print("ERROR: PR-test -> dev PR not found")
    sys.exit(1)

print("FOUND_PR={}".format(found))

with open("pr_number.txt", "w") as f:
    f.write(str(found))
PY

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "FOUND PR #${PR_NUMBER}"
                        echo "======================================"
                    '''
                }

                archiveArtifacts artifacts: 'pr_number.txt', fingerprint: true
            }
        }

        stage('Verify Jenkins CI') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "Checking PR #${PR_NUMBER}"

                        curl -s \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}" \
                          > pr.json

                        HEAD_SHA=$(python3 -c '
import json
d=json.load(open("pr.json"))
print(d["head"]["sha"])
')

                        echo "HEAD SHA: ${HEAD_SHA}"

                        curl -s \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          "https://api.github.com/repos/${GITHUB_REPO}/commits/${HEAD_SHA}/status" \
                          > status.json

                        python3 <<'PY'
import json
data = json.load(open("status.json"))

print("Overall status:", data.get("state"))

for s in data.get("statuses", []):
    print(
        "Context:",
        s.get("context"),
        "| State:",
        s.get("state")
    )
PY

                        JENKINS_STATUS=$(python3 - <<'PY'
import json

data = json.load(open("status.json"))

matches = [
    x for x in data.get("statuses", [])
    if x.get("context") == "continuous-integration/jenkins/branch"
]

if not matches:
    print("NOT_FOUND")
else:
    print(matches[-1].get("state", ""))
PY
)

                        echo "Jenkins required status: ${JENKINS_STATUS}"

                        if [ "${JENKINS_STATUS}" != "success" ]; then
                            echo "ERROR: Jenkins CI is not successful"
                            exit 1
                        fi

                        echo "JENKINS CI PASSED"
                    '''
                }
            }
        }

        stage('Approve PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "APPROVING PR #${PR_NUMBER}"
                        echo "Approver: ${GH_USER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X POST \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          -H "Content-Type: application/json" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/reviews" \
                          -d '{
                            "event": "APPROVE",
                            "body": "Automatically approved after successful Jenkins CI."
                          }')

                        echo "${RESPONSE}"

                        python3 <<'PY'
import json
import sys

with open("/dev/stdin") as f:
    pass
PY

                        APPROVAL_STATE=$(echo "${RESPONSE}" | python3 -c '
import sys,json
d=json.load(sys.stdin)

if "message" in d:
    print("ERROR:" + d["message"])
elif d.get("state") == "APPROVED":
    print("APPROVED")
else:
    print("ERROR:Approval failed")
')

                        echo "Approval result: ${APPROVAL_STATE}"

                        if [ "${APPROVAL_STATE}" != "APPROVED" ]; then
                            exit 1
                        fi

                        echo "PR APPROVED"
                    '''
                }
            }
        }

        stage('Wait For GitHub Rules') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "WAITING FOR GITHUB TO RECALCULATE PR"
                        echo "======================================"

                        for i in $(seq 1 30)
                        do
                            RESPONSE=$(curl -s \
                              -u "${GH_USER}:${GH_TOKEN}" \
                              -H "Accept: application/vnd.github+json" \
                              -H "X-GitHub-Api-Version: 2022-11-28" \
                              "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}")

                            MERGEABLE=$(echo "${RESPONSE}" | python3 -c '
import sys,json
d=json.load(sys.stdin)
v=d.get("mergeable")
print("null" if v is None else str(v).lower())
')

                            MERGE_STATE=$(echo "${RESPONSE}" | python3 -c '
import sys,json
print(json.load(sys.stdin).get("mergeable_state",""))
')

                            echo "Attempt ${i}/30"
                            echo "mergeable=${MERGEABLE}"
                            echo "mergeable_state=${MERGE_STATE}"

                            if [ "${MERGEABLE}" = "true" ] && \
                               [ "${MERGE_STATE}" = "clean" ]; then

                                echo "PR IS CLEAN AND MERGEABLE"
                                exit 0
                            fi

                            if [ "${MERGEABLE}" = "false" ]; then
                                echo "ERROR: PR is NOT mergeable"
                                echo "${RESPONSE}"
                                exit 1
                            fi

                            sleep 10
                        done

                        echo "ERROR: GitHub did not mark PR as mergeable"
                        exit 1
                    '''
                }
            }
        }

        stage('Merge PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "MERGING PR #${PR_NUMBER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X PUT \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          -H "Content-Type: application/json" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/merge" \
                          -d '{
                            "merge_method": "merge",
                            "commit_title": "Automatic merge: PR-test -> dev",
                            "commit_message": "Automatically merged after successful Jenkins CI."
                          }')

                        echo "${RESPONSE}"

                        MERGED=$(echo "${RESPONSE}" | python3 -c '
import sys,json
d=json.load(sys.stdin)
print(str(d.get("merged",False)).lower())
')

                        if [ "${MERGED}" != "true" ]; then
                            echo "ERROR: MERGE FAILED"
                            exit 1
                        fi

                        echo "======================================"
                        echo "PR #${PR_NUMBER} MERGED SUCCESSFULLY"
                        echo "PR-test -> dev"
                        echo "======================================"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "AUTOMATIC PR MERGE SUCCESS"
        }

        failure {
            echo "AUTOMATIC PR MERGE FAILED"
        }
    }
}
