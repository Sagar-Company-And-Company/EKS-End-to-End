pipeline {
    agent any

    environment {
        GITHUB_REPO   = 'Sagar-Company-And-Company/EKS-End-to-End'
        SOURCE_BRANCH = 'PR-test'
        TARGET_BRANCH = 'dev'
    }

    stages {

        stage('Find PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Finding PR: PR-test -> dev"
                        echo "======================================"

                        USER_RESPONSE=$(curl -s \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/user")

                        AUTH_USER=$(echo "$USER_RESPONSE" | python3 -c '
import sys,json
d=json.load(sys.stdin)
print(d.get("login",""))
')

                        echo "GitHub API user: ${AUTH_USER}"

                        if [ "$AUTH_USER" != "sj27773" ]; then
                            echo "ERROR: PR approval credential must belong to sj27773"
                            exit 1
                        fi

                        RESPONSE=$(curl -s \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&head=Sagar-Company-And-Company:${SOURCE_BRANCH}&base=${TARGET_BRANCH}")

                        PR_NUMBER=$(echo "$RESPONSE" | python3 -c '
import sys,json
d=json.load(sys.stdin)
print(d[0]["number"] if d else "")
')

                        if [ -z "$PR_NUMBER" ]; then
                            echo "ERROR: No open PR found"
                            exit 1
                        fi

                        echo "Found PR #${PR_NUMBER}"

                        echo "$PR_NUMBER" > pr_number.txt
                    '''
                }

                archiveArtifacts artifacts: 'pr_number.txt', fingerprint: true
            }
        }

        stage('Verify Jenkins CI') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "Checking Jenkins CI for PR #${PR_NUMBER}"
                        echo "======================================"

                        PR_RESPONSE=$(curl -s \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}")

                        HEAD_SHA=$(echo "$PR_RESPONSE" | python3 -c '
import sys,json
print(json.load(sys.stdin)["head"]["sha"])
')

                        echo "PR HEAD SHA: ${HEAD_SHA}"

                        STATUS_RESPONSE=$(curl -s \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/commits/${HEAD_SHA}/status")

                        JENKINS_STATUS=$(echo "$STATUS_RESPONSE" | python3 -c '
import sys,json

d=json.load(sys.stdin)

matches=[
    x for x in d.get("statuses",[])
    if x.get("context") == "continuous-integration/jenkins/branch"
]

print(matches[0].get("state","") if matches else "NOT_FOUND")
')

                        echo "Jenkins status: ${JENKINS_STATUS}"

                        if [ "$JENKINS_STATUS" != "success" ]; then
                            echo "ERROR: Required Jenkins status has not passed"
                            exit 1
                        fi

                        echo "Jenkins CI PASSED"
                    '''
                }
            }
        }

        stage('Approve PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "Approving PR #${PR_NUMBER}"
                        echo "Approver: ${GH_USER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X POST \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/reviews" \
                            -d '{
                                "event": "APPROVE",
                                "body": "Automatically approved after successful Jenkins CI."
                            }')

                        echo "$RESPONSE"

                        APPROVAL_STATE=$(echo "$RESPONSE" | python3 -c '
import sys,json

d=json.load(sys.stdin)

if "message" in d:
    print("ERROR:" + d["message"])
elif d.get("state") == "APPROVED":
    print("APPROVED")
else:
    print("ERROR:Approval was not successful")
')

                        echo "Approval result: ${APPROVAL_STATE}"

                        case "$APPROVAL_STATE" in
                            APPROVED)
                                echo "PR APPROVED SUCCESSFULLY"
                                ;;
                            *)
                                echo "PR APPROVAL FAILED"
                                exit 1
                                ;;
                        esac
                    '''
                }
            }
        }

        stage('Wait For Mergeable') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "Waiting for PR to become mergeable"
                        echo "======================================"

                        for i in $(seq 1 20)
                        do
                            RESPONSE=$(curl -s \
                                -u "${GH_USER}:${GH_TOKEN}" \
                                -H "Accept: application/vnd.github+json" \
                                "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}")

                            MERGEABLE=$(echo "$RESPONSE" | python3 -c '
import sys,json
v=json.load(sys.stdin).get("mergeable")
print(str(v).lower())
')

                            MERGE_STATE=$(echo "$RESPONSE" | python3 -c '
import sys,json
print(json.load(sys.stdin).get("mergeable_state",""))
')

                            echo "Attempt $i/20"
                            echo "mergeable=${MERGEABLE}"
                            echo "mergeable_state=${MERGE_STATE}"

                            if [ "$MERGEABLE" = "true" ] && [ "$MERGE_STATE" = "clean" ]; then
                                echo "======================================"
                                echo "PR IS READY TO MERGE"
                                echo "======================================"
                                exit 0
                            fi

                            if [ "$MERGEABLE" = "false" ]; then
                                echo "ERROR: GitHub says PR is not mergeable"
                                exit 1
                            fi

                            sleep 10
                        done

                        echo "ERROR: PR did not become mergeable"
                        exit 1
                    '''
                }
            }
        }

        stage('Merge PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "MERGING PR #${PR_NUMBER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X PUT \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/merge" \
                            -d '{
                                "merge_method": "merge",
                                "commit_title": "Automatic merge: PR-test -> dev",
                                "commit_message": "Automatically merged after successful Jenkins CI."
                            }')

                        echo "$RESPONSE"

                        MERGED=$(echo "$RESPONSE" | python3 -c '
import sys,json
print(str(json.load(sys.stdin).get("merged",False)).lower())
')

                        if [ "$MERGED" != "true" ]; then
                            echo "ERROR: PR MERGE FAILED"
                            exit 1
                        fi

                        echo "======================================"
                        echo "PR #${PR_NUMBER} MERGED SUCCESSFULLY"
                        echo "PR-test -> dev"
                        echo "======================================"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo "AUTOMATIC PR MERGE SUCCESS"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "AUTOMATIC PR MERGE FAILED"
            echo "======================================"
        }
    }
}
