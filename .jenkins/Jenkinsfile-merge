pipeline {
    agent any

    triggers {
        upstream(
            upstreamProjects: 'Jenkins PR CI/PR-test',
            threshold: hudson.model.Result.SUCCESS
        )
    }

    environment {
        GITHUB_REPO   = 'Sagar-Company-And-Company/EKS-End-to-End'
        SOURCE_BRANCH = 'PR-test'
        TARGET_BRANCH = 'dev'
    }

    stages {

        stage('Find PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'PR_USER',
                        passwordVariable: 'PR_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "Finding PR: PR-test -> dev"
                        echo "======================================"

                        RESPONSE=$(curl -s \
                            -u "${PR_USER}:${PR_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&head=Sagar-Company-And-Company:${SOURCE_BRANCH}&base=${TARGET_BRANCH}")

                        echo "$RESPONSE"

                        PR_NUMBER=$(echo "$RESPONSE" | python3 -c '
import sys
import json

data = json.load(sys.stdin)

if data:
    print(data[0]["number"])
else:
    print("")
')

                        if [ -z "$PR_NUMBER" ]; then
                            echo "No open PR found"
                            exit 1
                        fi

                        echo "Found PR #${PR_NUMBER}"

                        echo "$PR_NUMBER" > pr_number.txt
                    '''
                }

                archiveArtifacts artifacts: 'pr_number.txt', fingerprint: true
            }
        }

        stage('Verify Jenkins CI') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'PR_USER',
                        passwordVariable: 'PR_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "Checking Jenkins CI status for PR #${PR_NUMBER}"

                        PR_RESPONSE=$(curl -s \
                            -u "${PR_USER}:${PR_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}")

                        HEAD_SHA=$(echo "$PR_RESPONSE" | python3 -c '
import sys
import json
print(json.load(sys.stdin)["head"]["sha"])
')

                        echo "PR HEAD SHA: ${HEAD_SHA}"

                        STATUS_RESPONSE=$(curl -s \
                            -u "${PR_USER}:${PR_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/commits/${HEAD_SHA}/status")

                        echo "$STATUS_RESPONSE"

                        JENKINS_STATUS=$(echo "$STATUS_RESPONSE" | python3 -c '
import sys
import json

data = json.load(sys.stdin)

matches = [
    x for x in data.get("statuses", [])
    if x.get("context") == "continuous-integration/jenkins/branch"
]

if not matches:
    print("NOT_FOUND")
else:
    print(matches[0].get("state", ""))
')

                        echo "Jenkins status: ${JENKINS_STATUS}"

                        if [ "$JENKINS_STATUS" != "success" ]; then
                            echo "Required Jenkins status is not SUCCESS"
                            exit 1
                        fi

                        echo "Required Jenkins status PASSED"
                    '''
                }
            }
        }

        stage('Approve PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'PR_USER',
                        passwordVariable: 'PR_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "Approving PR #${PR_NUMBER}"
                        echo "Using GitHub user: ${PR_USER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X POST \
                            -u "${PR_USER}:${PR_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/reviews" \
                            -d '{
                                "event": "APPROVE",
                                "body": "Automatically approved after successful Jenkins CI."
                            }')

                        echo "$RESPONSE"

                        RESULT=$(echo "$RESPONSE" | python3 -c '
import sys
import json

data = json.load(sys.stdin)

if "message" in data:
    print("ERROR:" + data["message"])
elif data.get("state") == "APPROVED":
    print("APPROVED")
else:
    print("ERROR:Approval was not successful")
')

                        echo "$RESULT"

                        case "$RESULT" in
                            APPROVED)
                                echo "PR approved successfully"
                                ;;
                            *)
                                echo "PR approval failed"
                                exit 1
                                ;;
                        esac
                    '''
                }
            }
        }

        stage('Wait For Mergeable') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'PR_USER',
                        passwordVariable: 'PR_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "Waiting for GitHub mergeable state"
                        echo "======================================"

                        for i in $(seq 1 20)
                        do
                            RESPONSE=$(curl -s \
                                -u "${PR_USER}:${PR_TOKEN}" \
                                -H "Accept: application/vnd.github+json" \
                                "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}")

                            MERGEABLE=$(echo "$RESPONSE" | python3 -c '
import sys
import json
print(json.load(sys.stdin).get("mergeable"))
')

                            MERGE_STATE=$(echo "$RESPONSE" | python3 -c '
import sys
import json
print(json.load(sys.stdin).get("mergeable_state"))
')

                            echo "Attempt $i/20"
                            echo "mergeable=${MERGEABLE}"
                            echo "mergeable_state=${MERGE_STATE}"

                            if [ "$MERGEABLE" = "true" ] && [ "$MERGE_STATE" = "clean" ]; then
                                echo "PR is ready to merge"
                                exit 0
                            fi

                            if [ "$MERGEABLE" = "false" ]; then
                                echo "PR is not mergeable"
                                exit 1
                            fi

                            sleep 10
                        done

                        echo "PR did not become mergeable"
                        exit 1
                    '''
                }
            }
        }

        stage('Merge PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'PR_USER',
                        passwordVariable: 'PR_TOKEN'
                    )
                ]) {

                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "Merging PR #${PR_NUMBER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X PUT \
                            -u "${PR_USER}:${PR_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/merge" \
                            -d '{
                                "merge_method": "merge",
                                "commit_title": "Automatic merge: PR-test -> dev",
                                "commit_message": "Automatically merged after successful Jenkins CI."
                            }')

                        echo "$RESPONSE"

                        MERGED=$(echo "$RESPONSE" | python3 -c '
import sys
import json
print(json.load(sys.stdin).get("merged", False))
')

                        if [ "$MERGED" != "True" ]; then
                            echo "PR merge failed"
                            exit 1
                        fi

                        echo "======================================"
                        echo "PR #${PR_NUMBER} MERGED SUCCESSFULLY"
                        echo "PR-test -> dev"
                        echo "======================================"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo "AUTOMATIC PR MERGE SUCCESS"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "AUTOMATIC PR MERGE FAILED"
            echo "======================================"
        }
    }
}
