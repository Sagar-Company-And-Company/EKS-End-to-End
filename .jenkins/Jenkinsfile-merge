pipeline {
    agent any

    environment {
        GITHUB_REPO   = 'Sagar-Company-And-Company/EKS-End-to-End'
        SOURCE_BRANCH = 'PR-test'
        TARGET_BRANCH = 'dev'
    }

    stages {

        stage('Find PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        curl -s \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&per_page=100" \
                          > prs.json

                        PR_NUMBER=$(python3 - <<'PY'
import json
import sys

with open("prs.json") as f:
    data = json.load(f)

if isinstance(data, dict) and "message" in data:
    print("API_ERROR")
    sys.exit(1)

for pr in data:
    if (
        pr.get("state") == "open"
        and pr.get("head", {}).get("ref") == "PR-test"
        and pr.get("base", {}).get("ref") == "dev"
    ):
        print(pr["number"])
        sys.exit(0)

print("NOT_FOUND")
sys.exit(1)
PY
)

                        echo "Found PR #${PR_NUMBER}"
                        echo "${PR_NUMBER}" > pr_number.txt
                    '''
                }

                archiveArtifacts artifacts: 'pr_number.txt', fingerprint: true
            }
        }

        stage('Verify Jenkins CI') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        curl -s \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}" \
                          > pr.json

                        HEAD_SHA=$(python3 -c '
import json
print(json.load(open("pr.json"))["head"]["sha"])
')

                        echo "PR #${PR_NUMBER}"
                        echo "HEAD SHA: ${HEAD_SHA}"

                        curl -s \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          "https://api.github.com/repos/${GITHUB_REPO}/commits/${HEAD_SHA}/status" \
                          > status.json

                        python3 - <<'PY'
import json

data = json.load(open("status.json"))

print("Overall status:", data.get("state"))

for s in data.get("statuses", []):
    print(
        "Context:",
        s.get("context"),
        "State:",
        s.get("state")
    )
PY

                        JENKINS_STATUS=$(python3 - <<'PY'
import json

data = json.load(open("status.json"))

matches = [
    x for x in data.get("statuses", [])
    if x.get("context") == "continuous-integration/jenkins/branch"
]

if not matches:
    print("NOT_FOUND")
else:
    print(matches[-1].get("state", "").lower())
PY
)

                        echo "Jenkins status: ${JENKINS_STATUS}"

                        if [ "${JENKINS_STATUS}" != "success" ]; then
                            echo "Jenkins CI has not passed"
                            exit 1
                        fi

                        echo "JENKINS CI PASSED"
                    '''
                }
            }
        }

        stage('Approve PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "Approving PR #${PR_NUMBER}"
                        echo "Approver: ${GH_USER}"

                        RESPONSE=$(curl -s -X POST \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          -H "Content-Type: application/json" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/reviews" \
                          -d '{
                            "event": "APPROVE",
                            "body": "Automatically approved after successful Jenkins CI."
                          }')

                        echo "${RESPONSE}"

                        APPROVED=$(echo "${RESPONSE}" | python3 -c '
import sys,json
d=json.load(sys.stdin)

if "message" in d:
    print("ERROR:" + d["message"])
else:
    print(str(d.get("state","")).upper())
')

                        echo "Approval result: ${APPROVED}"

                        if [ "${APPROVED}" != "APPROVED" ]; then
                            echo "PR approval failed"
                            exit 1
                        fi

                        echo "PR APPROVED SUCCESSFULLY"
                    '''
                }
            }
        }

        stage('Wait For Mergeable') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        for i in $(seq 1 30)
                        do
                            echo "Checking mergeability - attempt ${i}/30"

                            curl -s \
                              -u "${GH_USER}:${GH_TOKEN}" \
                              -H "Accept: application/vnd.github+json" \
                              -H "X-GitHub-Api-Version: 2022-11-28" \
                              "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}" \
                              > merge.json

                            python3 - <<'PY'
import json

d = json.load(open("merge.json"))

print("mergeable =", d.get("mergeable"))
print("mergeable_state =", d.get("mergeable_state"))
print("state =", d.get("state"))
print("draft =", d.get("draft"))
PY

                            READY=$(python3 - <<'PY'
import json

d = json.load(open("merge.json"))

mergeable = d.get("mergeable")
state = d.get("mergeable_state")

if mergeable is True and state == "clean":
    print("YES")
else:
    print("NO")
PY
)

                            if [ "${READY}" = "YES" ]; then
                                echo "======================================"
                                echo "PR IS READY TO MERGE"
                                echo "======================================"
                                exit 0
                            fi

                            MERGE_STATE=$(python3 -c '
import json
print(json.load(open("merge.json")).get("mergeable_state"))
')

                            if [ "${MERGE_STATE}" = "dirty" ]; then
                                echo "GitHub reports PR as dirty/not mergeable"
                                cat merge.json
                                exit 1
                            fi

                            if [ "${MERGE_STATE}" = "blocked" ]; then
                                echo "PR is blocked by GitHub rules/checks"
                                cat merge.json
                                exit 1
                            fi

                            sleep 10
                        done

                        echo "PR did not become mergeable"
                        cat merge.json
                        exit 1
                    '''
                }
            }
        }

        stage('Merge PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "MERGING PR #${PR_NUMBER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X PUT \
                          -u "${GH_USER}:${GH_TOKEN}" \
                          -H "Accept: application/vnd.github+json" \
                          -H "X-GitHub-Api-Version: 2022-11-28" \
                          -H "Content-Type: application/json" \
                          "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/merge" \
                          -d '{
                            "merge_method": "merge",
                            "commit_title": "Automatic merge: PR-test -> dev",
                            "commit_message": "Automatically merged after successful Jenkins CI."
                          }')

                        echo "${RESPONSE}"

                        MERGED=$(echo "${RESPONSE}" | python3 -c '
import sys,json
d=json.load(sys.stdin)
print(str(d.get("merged",False)).lower())
')

                        if [ "${MERGED}" != "true" ]; then
                            echo "PR MERGE FAILED"
                            exit 1
                        fi

                        echo "======================================"
                        echo "PR #${PR_NUMBER} MERGED SUCCESSFULLY"
                        echo "PR-test -> dev"
                        echo "======================================"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "AUTOMATIC PR MERGE SUCCESS"
        }

        failure {
            echo "AUTOMATIC PR MERGE FAILED"
        }
    }
}
