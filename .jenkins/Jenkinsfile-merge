pipeline {
    agent any

    environment {
        GITHUB_REPO   = 'Sagar-Company-And-Company/EKS-End-to-End'
        SOURCE_BRANCH = 'PR-test'
        TARGET_BRANCH = 'dev'
    }

    stages {

        stage('Find PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Finding PR: PR-test -> dev"
                        echo "Using GitHub user: ${GH_USER}"
                        echo "======================================"

                        RESPONSE=$(curl -s \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls?state=open&head=Sagar-Company-And-Company:${SOURCE_BRANCH}&base=${TARGET_BRANCH}")

                        echo "$RESPONSE"

                        PR_NUMBER=$(echo "$RESPONSE" | python3 -c '
import sys
import json
data = json.load(sys.stdin)
print(data[0]["number"] if data else "")
')

                        if [ -z "$PR_NUMBER" ]; then
                            echo "ERROR: No open PR found"
                            exit 1
                        fi

                        echo "Found PR #${PR_NUMBER}"
                        echo "$PR_NUMBER" > pr_number.txt
                    '''
                }

                archiveArtifacts artifacts: 'pr_number.txt', fingerprint: true
            }
        }

        stage('Verify Jenkins CI') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        PR_RESPONSE=$(curl -s \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}")

                        HEAD_SHA=$(echo "$PR_RESPONSE" | python3 -c '
import sys
import json
print(json.load(sys.stdin)["head"]["sha"])
')

                        echo "PR #${PR_NUMBER}"
                        echo "HEAD SHA: ${HEAD_SHA}"

                        STATUS_RESPONSE=$(curl -s \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/commits/${HEAD_SHA}/status")

                        echo "$STATUS_RESPONSE"

                        JENKINS_STATUS=$(echo "$STATUS_RESPONSE" | python3 -c '
import sys
import json

data = json.load(sys.stdin)

matches = [
    x for x in data.get("statuses", [])
    if x.get("context") == "continuous-integration/jenkins/branch"
]

print(matches[0].get("state", "") if matches else "NOT_FOUND")
')

                        echo "Jenkins status: ${JENKINS_STATUS}"

                        if [ "$JENKINS_STATUS" != "success" ]; then
                            echo "ERROR: Jenkins CI has not passed"
                            exit 1
                        fi

                        echo "Jenkins CI PASSED"
                    '''
                }
            }
        }

        stage('Approve PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "Approving PR #${PR_NUMBER}"
                        echo "Approver: ${GH_USER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X POST \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/reviews" \
                            -d '{
                                "event": "APPROVE",
                                "body": "Automatically approved after successful Jenkins CI."
                            }')

                        echo "$RESPONSE"

                        RESULT=$(echo "$RESPONSE" | python3 -c '
import sys
import json

data = json.load(sys.stdin)

if "message" in data:
    print("ERROR:" + data["message"])
elif data.get("state") == "APPROVED":
    print("APPROVED")
else:
    print("ERROR:Approval was not successful")
')

                        echo "$RESULT"

                        case "$RESULT" in
                            APPROVED)
                                echo "PR APPROVED successfully"
                                ;;
                            *)
                                echo "PR APPROVAL FAILED"
                                exit 1
                                ;;
                        esac
                    '''
                }
            }
        }

        stage('Merge PR') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'PR-creds',
                        usernameVariable: 'GH_USER',
                        passwordVariable: 'GH_TOKEN'
                    )
                ]) {
                    sh '''
                        set -e

                        PR_NUMBER=$(cat pr_number.txt)

                        echo "======================================"
                        echo "Merging PR #${PR_NUMBER}"
                        echo "======================================"

                        RESPONSE=$(curl -s -X PUT \
                            -u "${GH_USER}:${GH_TOKEN}" \
                            -H "Accept: application/vnd.github+json" \
                            -H "Content-Type: application/json" \
                            "https://api.github.com/repos/${GITHUB_REPO}/pulls/${PR_NUMBER}/merge" \
                            -d '{
                                "merge_method": "merge",
                                "commit_title": "Automatic merge: PR-test -> dev",
                                "commit_message": "Automatically merged after successful Jenkins CI."
                            }')

                        echo "$RESPONSE"

                        MERGED=$(echo "$RESPONSE" | python3 -c '
import sys
import json
print(json.load(sys.stdin).get("merged", False))
')

                        if [ "$MERGED" != "True" ]; then
                            echo "ERROR: PR merge failed"
                            exit 1
                        fi

                        echo "======================================"
                        echo "PR #${PR_NUMBER} MERGED SUCCESSFULLY"
                        echo "PR-test -> dev"
                        echo "======================================"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "======================================"
            echo "AUTOMATIC PR MERGE SUCCESS"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "AUTOMATIC PR MERGE FAILED"
            echo "======================================"
        }
    }
}
