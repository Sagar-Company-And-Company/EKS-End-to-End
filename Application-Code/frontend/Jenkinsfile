pipeline {

    agent any

    environment {
        AWS_REGION     = 'us-east-1'
        ECR_REPOSITORY = 'aws-devops-production-frontend'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Frontend Build') {
            steps {
                dir('Application-Code/frontend') {
                    sh '''
                        echo "========== FRONTEND BUILD =========="

                        node --version
                        npm --version

                        npm install

                        echo "Frontend build completed."
                    '''
                }
            }
        }

        stage('Get AWS Information') {
            steps {
                script {

                    env.AWS_ACCOUNT_ID = sh(
                        script: 'aws sts get-caller-identity --query Account --output text',
                        returnStdout: true
                    ).trim()

                    env.ECR_REGISTRY =
                        "${env.AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

                    env.ECR_IMAGE =
                        "${env.ECR_REGISTRY}/${ECR_REPOSITORY}:latest"

                    echo "AWS Account: ${env.AWS_ACCOUNT_ID}"
                    echo "ECR Image: ${env.ECR_IMAGE}"
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "========== DOCKER BUILD =========="

                    docker build \
                    -t ${ECR_REPOSITORY}:latest \
                    ./Application-Code/frontend

                    docker images
                '''
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    echo "========== TRIVY SCAN =========="

                    trivy image \
                    --severity CRITICAL \
                    --exit-code 0 \
                    --no-progress \
                    ${ECR_REPOSITORY}:latest
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    echo "========== ECR LOGIN =========="

                    aws ecr get-login-password \
                    --region ${AWS_REGION} | \
                    docker login \
                    --username AWS \
                    --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Tag Docker Image') {
            steps {
                sh '''
                    echo "========== TAG IMAGE =========="

                    docker tag \
                    ${ECR_REPOSITORY}:latest \
                    ${ECR_IMAGE}
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    echo "========== PUSH IMAGE =========="

                    docker push ${ECR_IMAGE}
                '''
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    echo "========== VERIFY IMAGE =========="

                    aws ecr describe-images \
                    --repository-name ${ECR_REPOSITORY} \
                    --region ${AWS_REGION}
                '''
            }
        }
    }

    post {

        success {
            echo "===================================="
            echo "FRONTEND PIPELINE SUCCESS"
            echo "Image: ${ECR_IMAGE}"
            echo "===================================="
        }

        failure {
            echo "===================================="
            echo "FRONTEND PIPELINE FAILED"
            echo "===================================="
        }

        always {
            sh '''
                rm -rf Application-Code/frontend/node_modules || true
            '''
        }
    }
}
