pipeline {
    agent any

    environment {
        AWS_REGION     = 'us-east-1'
        ECR_REPOSITORY = 'aws-devops-production-frontend'
        IMAGE_TAG      = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========== CHECKOUT =========='
                checkout scm

                sh '''
                    echo "Branch:"
                    git branch --show-current

                    echo "Commit:"
                    git rev-parse --short HEAD

                    echo "Repository:"
                    ls -la
                '''
            }
        }

        stage('Frontend Build') {
            steps {
                dir('Application-Code/frontend') {
                    sh '''
                        echo "========== FRONTEND BUILD =========="

                        node --version
                        npm --version

                        if [ -f package-lock.json ]; then
                            npm ci
                        else
                            npm install
                        fi

                        npm run build
                    '''
                }
            }
        }

        // stage('SonarQube Analysis') {
        //     steps {
        //         dir('frontend') {
        //             script {
        //                 def scannerHome = tool 'sonar-scanner'

        //                 withSonarQubeEnv('SonarQube') {
        //                     sh """
        //                         echo "========== SONARQUBE =========="

        //                         ${scannerHome}/bin/sonar-scanner \
        //                           -Dsonar.projectKey=devops-frontend \
        //                           -Dsonar.projectName=devops-frontend \
        //                           -Dsonar.sources=src
        //                     """
        //                 }
        //             }
        //         }
        //     }
        // }

        // stage('SonarQube Quality Gate') {
        //     steps {
        //         echo '========== QUALITY GATE =========='

        //         timeout(time: 10, unit: 'MINUTES') {
        //             waitForQualityGate abortPipeline: true
        //         }
        //     }
        // }

        stage('Get AWS Information') {
            steps {
                script {
                    env.AWS_ACCOUNT_ID = sh(
                        script: 'aws sts get-caller-identity --query Account --output text',
                        returnStdout: true
                    ).trim()

                    env.ECR_REGISTRY =
                        "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

                    env.ECR_IMAGE =
                        "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"

                    echo "AWS Account: ${env.AWS_ACCOUNT_ID}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                    echo "ECR Image: ${env.ECR_IMAGE}"
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    echo "========== DOCKER BUILD =========="

                    docker build \
                      -t ${ECR_REPOSITORY}:${IMAGE_TAG} \
                      ./Application-Code/frontend

                    docker images | grep ${ECR_REPOSITORY}
                '''
            }
        }

        stage('Trivy Scan') {
            steps {
                sh '''
                    echo "========== TRIVY SCAN =========="

                    trivy image \
                      --severity CRITICAL \
                      --exit-code 1 \
                      --no-progress \
                      ${ECR_REPOSITORY}:${IMAGE_TAG}
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    echo "========== ECR LOGIN =========="

                    aws ecr get-login-password \
                      --region ${AWS_REGION} \
                    | docker login \
                      --username AWS \
                      --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Tag Docker Image') {
            steps {
                sh '''
                    echo "========== TAG IMAGE =========="

                    docker tag \
                      ${ECR_REPOSITORY}:${IMAGE_TAG} \
                      ${ECR_IMAGE}
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    echo "========== PUSH TO ECR =========="

                    docker push ${ECR_IMAGE}
                '''
            }
        }

        stage('Verify Image') {
            steps {
                sh '''
                    echo "========== VERIFY ECR =========="

                    aws ecr describe-images \
                      --repository-name ${ECR_REPOSITORY} \
                      --region ${AWS_REGION} \
                      --image-ids imageTag=${IMAGE_TAG}
                '''
            }
        }
    }

    post {

        success {
            echo '========================================'
            echo 'FRONTEND CI PIPELINE SUCCESSFUL'
            echo "Image: ${ECR_IMAGE}"
            echo '========================================'
        }

        failure {
            echo '========================================'
            echo 'FRONTEND CI PIPELINE FAILED'
            echo 'Check the failed stage above.'
            echo '========================================'
        }

        always {
            sh '''
                echo "Cleaning Jenkins workspace..."
                rm -rf frontend/node_modules || true
            '''
        }
    }
}

