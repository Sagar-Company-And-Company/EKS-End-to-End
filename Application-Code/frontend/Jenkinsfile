pipeline {

    agent any

    environment {
        AWS_REGION     = 'us-east-1'
        ECR_REPOSITORY = 'aws-devops-production-frontend'
        IMAGE_TAG      = "${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo '========== CHECKOUT =========='

                checkout scm

                sh '''
                    echo "Branch:"
                    git branch --show-current

                    echo "Commit:"
                    git rev-parse --short HEAD

                    echo "Repository:"
                    ls -la

                    echo "Frontend directory:"
                    ls -la Application-Code/frontend
                '''
            }
        }


        stage('Frontend Build') {
            steps {

                dir('Application-Code/frontend') {

                    sh '''
                        echo "========== FRONTEND BUILD =========="

                        echo "Node version:"
                        node --version

                        echo "NPM version:"
                        npm --version

                        echo "Installing dependencies..."

                        npm install

                        echo "Building React application..."

                        echo "Frontend build completed successfully."
                    '''
                }
            }
        }


        stage('Get AWS Information') {
            steps {

                script {

                    echo '========== AWS INFORMATION =========='

                    env.AWS_ACCOUNT_ID = sh(
                        script: '''
                            aws sts get-caller-identity \
                            --query Account \
                            --output text
                        ''',
                        returnStdout: true
                    ).trim()

                    env.ECR_REGISTRY =
                        "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

                    env.ECR_IMAGE =
                        "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"

                    echo "AWS Account ID: ${env.AWS_ACCOUNT_ID}"
                    echo "AWS Region: ${env.AWS_REGION}"
                    echo "ECR Repository: ${env.ECR_REPOSITORY}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                    echo "ECR Image: ${env.ECR_IMAGE}"
                }
            }
        }


        stage('Docker Build') {
            steps {

                sh '''
                    echo "========== DOCKER BUILD =========="

                    docker --version

                    docker build \
                        -t ${ECR_REPOSITORY}:${IMAGE_TAG} \
                        ./Application-Code/frontend

                    echo "Docker image created:"

                    docker images | grep ${ECR_REPOSITORY}
                '''
            }
        }


        stage('Trivy Scan') {
            steps {

                sh '''
                    echo "========== TRIVY SECURITY SCAN =========="

                    trivy --version

                    trivy image \
                        --severity CRITICAL \
                        --exit-code 1 \
                        --no-progress \
                        ${ECR_REPOSITORY}:${IMAGE_TAG}

                    echo "Trivy scan completed successfully."
                '''
            }
        }


        stage('ECR Login') {
            steps {

                sh '''
                    echo "========== ECR LOGIN =========="

                    aws ecr get-login-password \
                        --region ${AWS_REGION} \
                    | docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}

                    echo "ECR login successful."
                '''
            }
        }


        stage('Tag Docker Image') {
            steps {

                sh '''
                    echo "========== TAG DOCKER IMAGE =========="

                    docker tag \
                        ${ECR_REPOSITORY}:${IMAGE_TAG} \
                        ${ECR_IMAGE}

                    echo "Tagged image:"
                    echo ${ECR_IMAGE}
                '''
            }
        }


        stage('Push Image to ECR') {
            steps {

                sh '''
                    echo "========== PUSH IMAGE TO ECR =========="

                    docker push ${ECR_IMAGE}

                    echo "Image pushed successfully."
                '''
            }
        }


        stage('Verify Image') {
            steps {

                sh '''
                    echo "========== VERIFY ECR IMAGE =========="

                    aws ecr describe-images \
                        --repository-name ${ECR_REPOSITORY} \
                        --region ${AWS_REGION} \
                        --image-ids imageTag=${IMAGE_TAG}

                    echo "ECR image verified successfully."
                '''
            }
        }
    }


    post {

        success {

            echo '''
            ========================================
            FRONTEND CI PIPELINE SUCCESSFUL
            ========================================
            '''

            echo "Docker Image: ${ECR_IMAGE}"
            echo "Build Number: ${BUILD_NUMBER}"
        }


        failure {

            echo '''
            ========================================
            FRONTEND CI PIPELINE FAILED
            ========================================
            '''

            echo "Check the failed stage in Console Output."
        }


        always {

            sh '''
                echo "========== CLEANUP =========="
                echo "========== CLEANUP =========="

                rm -rf Application-Code/frontend/node_modules || true
            '''
        }
    }
}
