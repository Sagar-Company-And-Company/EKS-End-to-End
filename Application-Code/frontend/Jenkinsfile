pipeline {

    agent any

    options {
        skipDefaultCheckout(true)
    }

    environment {
        AWS_REGION     = 'us-east-1'
        ECR_REPOSITORY = 'aws-devops-production-frontend'
        IMAGE_TAG      = "${BUILD_NUMBER}"

        MANIFEST_REPO  = 'https://github.com/sj27773/k8-manifests.git'

        SKIP_FRONTEND  = 'false'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Frontend Changes') {
            steps {
                script {

                    echo "========== CHECK FRONTEND CHANGES =========="

                    def changes = sh(
                        script: """
                            git diff --name-only HEAD~1 HEAD -- 'Application-Code/frontend/**' || true
                        """,
                        returnStdout: true
                    ).trim()

                    if (changes) {

                        echo "Frontend changes detected:"
                        echo changes

                        env.SKIP_FRONTEND = 'false'

                    } else {

                        echo "No frontend changes detected."
                        echo "Skipping frontend build and deployment."

                        env.SKIP_FRONTEND = 'true'
                    }
                }
            }
        }

        stage('Frontend Build') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {
                dir('Application-Code/frontend') {

                    sh '''
                        echo "========== FRONTEND BUILD =========="

                        node --version
                        npm --version

                        npm install

                        echo "Frontend build completed successfully."
                    '''
                }
            }
        }

        stage('Get AWS Information') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {

                script {

                    echo "========== AWS INFORMATION =========="

                    env.AWS_ACCOUNT_ID = sh(
                        script: '''
                            aws sts get-caller-identity \
                            --query Account \
                            --output text
                        ''',
                        returnStdout: true
                    ).trim()

                    env.ECR_REGISTRY =
                        "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com"

                    env.ECR_IMAGE =
                        "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"

                    echo "AWS Account ID = ${env.AWS_ACCOUNT_ID}"
                    echo "ECR Registry   = ${env.ECR_REGISTRY}"
                    echo "ECR Image      = ${env.ECR_IMAGE}"
                }
            }
        }

        stage('Docker Build') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {

                sh '''
                    echo "========== DOCKER BUILD =========="

                    docker build \
                        -t ${ECR_REPOSITORY}:${IMAGE_TAG} \
                        ./Application-Code/frontend
                '''
            }
        }

        stage('Trivy Scan') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {

                sh '''
                    echo "========== TRIVY SCAN =========="

                    trivy image \
                        --severity CRITICAL \
                        --exit-code 0 \
                        --no-progress \
                        ${ECR_REPOSITORY}:${IMAGE_TAG}
                '''
            }
        }

        stage('ECR Login') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {

                sh '''
                    echo "========== ECR LOGIN =========="

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                '''
            }
        }

        stage('Tag Docker Image') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {

                sh '''
                    echo "========== TAG DOCKER IMAGE =========="

                    docker tag \
                        ${ECR_REPOSITORY}:${IMAGE_TAG} \
                        ${ECR_IMAGE}
                '''
            }
        }

        stage('Push Image To ECR') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {

                sh '''
                    echo "========== PUSH IMAGE TO ECR =========="

                    docker push ${ECR_IMAGE}
                '''
            }
        }

        stage('Update Manifest Repo') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'manifest-github-creds',
                        usernameVariable: 'GIT_USERNAME',
                        passwordVariable: 'GIT_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "========== UPDATE FRONTEND MANIFEST =========="

                        rm -rf k8-manifests

                        git clone \
                            https://${GIT_USERNAME}:${GIT_TOKEN}@github.com/sj27773/k8-manifests.git \
                            k8-manifests

                        cd k8-manifests

                        echo "Updating frontend deployment image..."

                        sed -i "s|image:.*|image: ${ECR_IMAGE}|g" \
                            frontend/deployment.yaml

                        echo "Updated frontend deployment:"
                        cat frontend/deployment.yaml

                        git config user.email "jenkins@local"
                        git config user.name "Jenkins"

                        git add frontend/deployment.yaml

                        git diff --cached

                        git commit \
                            -m "Update frontend image ${IMAGE_TAG}" || true

                        git push origin main
                    '''
                }
            }
        }

        stage('Verify Image') {
            when {
                expression {
                    env.SKIP_FRONTEND != 'true'
                }
            }

            steps {

                sh '''
                    echo "========== VERIFY ECR IMAGE =========="

                    aws ecr describe-images \
                        --repository-name ${ECR_REPOSITORY} \
                        --region ${AWS_REGION} \
                        --image-ids imageTag=${IMAGE_TAG}
                '''
            }
        }
    }

    post {

        success {

            script {

                if (env.SKIP_FRONTEND == 'true') {

                    echo '''
========================================
FRONTEND PIPELINE SUCCESS
NO FRONTEND CHANGES - BUILD SKIPPED
========================================
'''

                } else {

                    echo '''
========================================
FRONTEND PIPELINE SUCCESS
BUILD + ECR + MANIFEST UPDATE COMPLETED
========================================
'''
                }
            }
        }

        failure {

            echo '''
========================================
FRONTEND PIPELINE FAILED
========================================
'''
        }

        always {

            sh '''
                echo "Cleaning frontend workspace..."

                rm -rf Application-Code/frontend/node_modules || true
                rm -rf k8-manifests || true
            '''
        }
    }
}
